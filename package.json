{
  "name": "@uni-design-system/uni-react-icons",
  "author": "George English",
  "license": "MIT",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "description": "React component icon library for the UNI Design System.",
  "keywords": [
    "React",
    "SVG",
    "Icons"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf src && rimraf dist",
    "build": "npm run svgr && yarn build:esm && yarn build:cjs",
    "svgr": "svgr -- icons",
    "build:esm": "tsc",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@svgr/babel-plugin-transform-svg-component": "^8.0.0",
    "@svgr/cli": "^8.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
